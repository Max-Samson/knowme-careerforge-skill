{
  "name": "knowme-careerforge-skill",
  "version": "0.0.6",
  "description": "An agent-native skill for self-discovery, career positioning, and tailored resume engineering.",
  "main": "dist/cli/src/index.js",
  "bin": {
    "knowme": "bin/knowme.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "scripts",
    "agents",
    "SKILL.md",
    "skill.json",
    "references",
    "AGENT.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "python3 scripts/build/run-all-tests.py",
    "forge": "python3 scripts/pipeline/forge.py",
    "extract": "python3 scripts/evidence/extract-evidence.py",
    "search": "python3 scripts/template/search-template.py",
    "analyze:jd": "python3 scripts/evidence/analyze-jd.py",
    "instantiate": "python3 scripts/template/instantiate-resume.py",
    "validate": "python3 scripts/validation/validate-resume.py",
    "validate:layout": "ts-node scripts/validation/validate-layout.ts",
    "validate:ats": "ts-node scripts/validation/validate-ats.ts",
    "render:pdf": "python3 scripts/rendering/render-pdf.py",
    "build:knowledge": "python3 scripts/build/build-knowledge.py",
    "build:gallery": "python3 scripts/build/build-gallery.py",
    "release": "python3 scripts/build/release.py",
    "ersion:sync": "python3 scripts/build/sync-version.py",
    "prepublishOnly": "npm test",
    "pretest": "npm run build"
  },
  "keywords": [
    "career-forge",
    "know-me",
    "resume-engineering",
    "agent-skill",
    "ai-resume",
    "design-tokens",
    "playwright-pdf",
    "ats-friendly"
  ],
  "author": "Miles <https://github.com/Max-Samson>",
  "license": "MIT",
  "homepage": "https://github.com/Max-Samson/knowme-careerforge-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Samson/knowme-careerforge-skill.git"
  },
  "bugs": {
    "url": "https://github.com/Max-Samson/knowme-careerforge-skill/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
