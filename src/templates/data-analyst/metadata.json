{
  "id": "data-analyst",
  "name": "Data Analyst Metric Stream",
  "version": "1.0.0",
  "style": "two-column-metrics",
  "roleCategory": "data-analytics",
  "layout": {
    "type": "two-column-sidebar",
    "targetPages": 1,
    "maxPages": 1,
    "sidebarRatio": "30:70",
