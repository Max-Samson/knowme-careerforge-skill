  "languages": ["zh-CN", "en-US"],
  "customizableTokens": [
    "--resume-font-size-body",
    "--resume-line-height-body",
    "--resume-space-section",
    "--resume-space-item",
    "--resume-space-bullet",
    "--resume-sidebar-width",
    "--resume-color-accent"
