  },
  "visualStyle": {
    "tone": "amber-cyan",
    "accentColor": "#0891b2",
    "sidebarBg": "#f0fdfa",
    "fontFamily": "System Sans-Serif"
  },
  "atsScoreTier": "tier-1-optimal",
  "supportedRoles": [
    "data-analyst",
    "data-scientist",
    "bi-engineer",
    "growth-architect",
    "data-engineer",
    "machine-learning-engineer"
